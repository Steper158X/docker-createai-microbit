diff --git a/src/makecode/self-hosted.ts b/src/makecode/self-hosted.ts
new file mode 100644
index 0000000..ac8d96d
--- /dev/null
+++ b/src/makecode/self-hosted.ts
@@ -0,0 +1,25 @@
+/**
+ * (c) 2026, Micro:bit Educational Foundation and contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+/**
+ * Optional self-hosted MakeCode (e.g. a `pxt staticpkg` build for offline
+ * deployments). VITE_MAKECODE_URL may be relative to the app's location.
+ * Undefined means the default makecode.microbit.org.
+ */
+const resolve = (value: string | undefined): string | undefined =>
+  value ? new URL(value, window.location.href).href : undefined;
+
+const env = import.meta.env as unknown as Record<string, string | undefined>;
+
+export const makeCodeBaseUrl = resolve(env.VITE_MAKECODE_URL);
+
+export const makeCodeRenderBlocksUrl = resolve(
+  env.VITE_MAKECODE_RENDER_BLOCKS_URL
+);
+
+/** Bundled extension reference used when MakeCode is self-hosted. */
+export const makeCodeMlExtensionOverride =
+  env.VITE_MAKECODE_ML_EXTENSION || undefined;
